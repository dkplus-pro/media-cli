{
  "name": "@dkplus/media-cli",
  "version": "0.1.2",
  "description": "通用插件化 Node CLI：图片压缩与文字水印（sharp）、视频胶片图/音视频转化（ffmpeg）、SRT 字幕（whisper.cpp）、Azure gpt-image-2 生图、Suno 音乐生成；给人用也给 AI 用",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkplus-pro/media-cli.git"
  },
  "keywords": [
    "cli",
    "media",
    "image",
    "image-compression",
    "watermark",
    "sharp",
    "video",
    "audio",
    "ffmpeg",
    "whisper",
    "srt",
    "subtitle",
    "azure-openai",
    "gpt-image",
    "suno",
    "text-to-image",
    "text-to-music",
    "ai"
  ],
  "bin": {
    "media-cli": "dist/media-cli.js"
  },
  "files": [
    "dist",
    "plugins",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/bin/media-cli.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -s build && vitest run",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "lint-staged": "^16.1.0",
    "simple-git-hooks": "^2.13.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json}": "biome check --write"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "sharp": "^0.35.4"
  }
}
