{
  "name": "dk-media",
  "version": "0.0.0",
  "private": true,
  "description": "A media CLI project.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:demo": "pnpm --filter @dk-media/demo run build",
    "build:pages": "bash scripts/deploy-github-pages.sh",
    "ci": "bash scripts/ci.sh",
    "clean": "turbo run clean",
    "commitlint": "commitlint",
    "dev": "turbo run dev --parallel",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "turbo run lint && pnpm run lint:root",
    "lint:root": "eslint . --max-warnings=0",
    "prepare": "husky",
    "test": "pnpm run test:unit && turbo run test && pnpm run test:e2e",
    "test:e2e": "playwright test",
    "test:live": "pnpm --filter @dkplus/dk-audio... --filter @dkplus/dk-image... --filter @dkplus/dk-video... run build && node --test tests/live/*.test.mjs",
    "test:smoke": "pnpm --filter @dkplus/dk-audio... --filter @dkplus/dk-image... --filter @dkplus/dk-video... run build && node --test tests/smoke/*.test.mjs",
    "test:unit": "jest --config jest.config.cjs",
    "typecheck": "turbo run typecheck",
    "verify": "bash scripts/verify.sh"
  },
  "lint-staged": {
    "*.{json,md,mdx,css,scss,yaml,yml}": [
      "prettier --write"
    ],
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@playwright/test": "^1.61.1",
    "@repo/commitlint-config": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/jest": "^30.0.0",
    "eslint": "10.6.0",
    "husky": "9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "prettier-plugin-packagejson": "3.0.2",
    "turbo": "2.10.4",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20.19.5",
    "pnpm": ">=10.1.0"
  }
}
