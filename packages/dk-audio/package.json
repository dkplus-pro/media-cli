{
  "name": "@dkplus/dk-audio",
  "version": "0.1.0",
  "description": "Audio transcription and music analysis CLI for dkplus.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "dk-audio": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "commands.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf .turbo dist coverage",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dkplus/ai-core": "workspace:*",
    "@dkplus/cli-core": "workspace:*",
    "@dkplus/contracts": "workspace:*",
    "@dkplus/media-core": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@dkplus/testing": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^24.10.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
