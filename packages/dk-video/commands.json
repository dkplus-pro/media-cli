{
  "package": "@dkplus/dk-video",
  "binary": "dk-video",
  "commands": [
    {
      "command": "probe",
      "description": "Read deterministic local video metadata.",
      "input": { "type": "video-file" },
      "outputs": ["video-probe-json"]
    },
    {
      "command": "audio",
      "description": "Extract a local audio artifact linked to a video source.",
      "input": { "type": "video-file", "output": "audio-file" },
      "outputs": ["video-audio-json"]
    },
    {
      "command": "filmstrip",
      "description": "Create a four-frame filmstrip artifact linked to a video source.",
      "input": { "type": "video-file", "output": "image-file" },
      "outputs": ["video-filmstrip-json"]
    },
    {
      "command": "subtitles",
      "description": "Extract temporary audio and transcribe it through an injected adapter.",
      "input": { "type": "video-file" },
      "outputs": ["transcript-json"]
    },
    {
      "command": "content summary",
      "description": "Summarize matching transcript and filmstrip artifacts through a configured provider.",
      "input": {
        "type": "video-file",
        "transcript": "transcript-json",
        "filmstrip": "video-filmstrip-json"
      },
      "outputs": ["video-content-summary-json"]
    },
    {
      "command": "content keywords",
      "description": "Extract keywords from matching transcript and filmstrip artifacts through a configured provider.",
      "input": {
        "type": "video-file",
        "transcript": "transcript-json",
        "filmstrip": "video-filmstrip-json"
      },
      "outputs": ["video-content-keywords-json"]
    },
    {
      "command": "content highlights",
      "description": "Extract timestamped highlights from matching transcript and filmstrip artifacts through a configured provider.",
      "input": {
        "type": "video-file",
        "transcript": "transcript-json",
        "filmstrip": "video-filmstrip-json"
      },
      "outputs": ["video-content-highlights-json"]
    },
    {
      "command": "analyze",
      "description": "Compose only explicitly supplied matching video prerequisite artifacts.",
      "input": { "type": "video-file", "prerequisites": "video-artifacts" },
      "outputs": ["video-analysis-json"]
    }
  ]
}
